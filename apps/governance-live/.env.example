# Server-side only. Keep this workspace on loopback with mock data.
ALERT_SERVICE_URL=http://127.0.0.1:8085
AUDIT_SERVICE_URL=http://127.0.0.1:8090
# This is a configured development identity, not an authenticated end-user session.
GOVERNANCE_PRINCIPAL=governance-dev-reviewer
# Exact browser-facing origin, without a trailing slash (required for standalone/Compose).
GOVERNANCE_ORIGIN=http://127.0.0.1:3006
# If alert-service uses an internal token, configure the same value here.
INTERNAL_API_TOKEN=

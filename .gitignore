.env
.env.*
!.env.example

.DS_Store

# Go build output
services/state-service/state-service

# Live eval session outputs (scenarios and scripts are committed)
evals/live-model/results/*.json

# Python
__pycache__/
*.pyc
.venv/

# Node / Next.js
**/node_modules/
**/.next/

# Java build output
jobs/compliance-cep/target/
jobs/compliance-cep/dependency-reduced-pom.xml

# Agent git worktrees (see scripts/agent-worktree.sh)
.worktrees/

# Local Cursor agent wiring — ship .cursor/rules/ (and commands/) only
.cursor/mcp.json
.cursor/hooks.json
.cursor/agents/

# Dev TLS private keys (public certs under infra/tls/ may be committed)
infra/tls/*.key

# Ephemeral local smoke / harness logs (claim marker is committed intentionally)
evidence/*.txt
evidence/*.json
!evidence/cutting-edge-claims-allowed.marker
